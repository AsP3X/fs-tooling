{
  "manifest_version": 3,
  "name": "Freshservice Ops Panel",
  "version": "2.5.0",
  "description": "Compact ops panel for Freshservice tickets and onboarding journeys.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Ops panel",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.freshservice.com/*",
    "https://*.myfreshworks.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.freshservice.com/*",
        "https://*.myfreshworks.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
