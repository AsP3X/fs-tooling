{
  "manifest_version": 3,
  "name": "Freshservice Ops Panel",
  "version": "2.1.0",
  "description": "Highlight, filter, and sort Freshservice tickets and onboarding journeys. Adds a Start date column on Journeys.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Ops panel (Tickets and Journeys)",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.freshservice.com/*",
        "https://*.myfreshworks.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
